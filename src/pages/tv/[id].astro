---
// Static prerender — one page per public video, built at deploy time.
export const prerender = true

// ──────────────────────────────────────────────────────────────────────────────
// /tv/[id] — watch page: player, title, date, view count and like button
// (scripts/video-stats.ts), description, a link to the essay it goes with
// (if any), tags, and a few more videos underneath.
//
// Playback is Mux Player (a web component, loaded only on this page). It
// needs nothing but the entry's public playback ID. Until its script has
// loaded, the frame shows the video's still image at the right shape, so
// the page doesn't jump.
// ──────────────────────────────────────────────────────────────────────────────

import type { GetStaticPaths } from 'astro'
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import VideoCard from '../../components/VideoCard.astro'
import { getPublicVideos } from '../../lib/video-collection'
import { formatLongDate } from '../../lib/format-date'
import { cssAspectRatio, formatDuration, isoDuration, videoStill } from '../../lib/video'
import { publicOnly } from '../../lib/sort-group'
import { itemUrl } from '../../lib/item-url'

export const getStaticPaths = (async () => {
  const videos = await getPublicVideos()
  // Essays a video can point at (hidden ones are never linked).
  const essays = publicOnly(await getCollection('writing'))
  return videos.map((item) => ({
    params: { id: item.data.id },
    props: {
      item,
      more: videos.filter((v) => v.data.id !== item.data.id).slice(0, 3),
      essay: item.data.essay ? essays.find((e) => e.data.id === item.data.essay) : undefined,
    },
  }))
}) satisfies GetStaticPaths

const { item, more, essay } = Astro.props
const v = item.data
const { Content } = await render(item)

// Custom uploaded thumbnail if there is one, else a frame from the video.
const poster = videoStill(v, 'poster')
const shareImage = videoStill(v, 'share')
const duration = formatDuration(v.durationSec)
// The address the share button hands out: always the canonical page, so
// the link preview shows this video's thumbnail and title.
const shareUrl = new URL(`/tv/${v.id}`, Astro.site).toString()

// Plain-text summary for <meta description> and search results: the body
// with markdown/HTML markers stripped, trimmed to a sentence or two.
const plain = (item.body ?? '')
  .replace(/<[^>]*>/g, ' ')
  .replace(/!?\[([^\]]*)\]\([^)]*\)/g, '$1')
  .replace(/[*_`#>]/g, '')
  .replace(/\s+/g, ' ')
  .trim()
const description = plain
  ? (plain.length > 180 ? `${plain.slice(0, 177).trimEnd()}…` : plain)
  : `${v.title} — video by Christopher Shenefelt.`

// Structured data so search engines can list this as a video.
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: v.title,
  description,
  thumbnailUrl: [shareImage],
  uploadDate: v.date,
  duration: isoDuration(v.durationSec),
  contentUrl: `https://stream.mux.com/${v.playbackId}.m3u8`,
}).replace(/</g, '\\u003c')
---

<BaseLayout title={v.title} active="tv" description={description} ogImage={shareImage}>
  <div class="art-back">
    <a href="/tv">← Back to TV</a>
  </div>

  <div
    class="tv-player"
    style={`aspect-ratio: ${cssAspectRatio(v.aspectRatio)}; background-image: url('${poster}');`}
  >
    <mux-player
      playback-id={v.playbackId}
      stream-type="on-demand"
      poster={poster}
      video-title={v.title}
      metadata-video-id={v.id}
      metadata-video-title={v.title}
      accent-color="#4F7CFF"
      disable-cookies
      playsinline
      data-count-views={v.id}
    ></mux-player>
    <noscript>
      <video controls playsinline poster={poster} src={`https://stream.mux.com/${v.playbackId}.m3u8`}></video>
    </noscript>
  </div>

  <header class="tv-meta">
    {v.series && <span class="eyebrow">{v.series}</span>}
    <h1>{v.title}</h1>
    <div class="tv-meta__row">
      <p class="tv-meta__line">
        <time datetime={v.date}>{formatLongDate(v.date)}</time>
        {duration && <span> · {duration}</span>}
        <span class="tv-views" data-views-for={v.id} data-views-format="full" hidden></span>
      </p>
      <div class="tv-actions">
        <button type="button" class="tv-like" data-like={v.id} aria-pressed="false" hidden>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 3 4.5 6.8 4.5c2 0 3.6 1.1 5.2 3 1.6-1.9 3.2-3 5.2-3 3.8 0 5.9 3.9 4.4 7.3C19.5 16.4 12 21 12 21z" />
          </svg>
          <span data-likes>0</span>
        </button>
        <button type="button" class="tv-share" data-share data-share-url={shareUrl} data-share-title={v.title} hidden>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M12 3v12M7.5 7.5 12 3l4.5 4.5M6 11H5a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7a1 1 0 0 0-1-1h-1" />
          </svg>
          <span data-share-label aria-live="polite">Share</span>
        </button>
      </div>
    </div>
  </header>

  {plain && (
    <div class="tv-description">
      <Content />
    </div>
  )}

  {essay && (
    <a class="tv-essay" href={itemUrl(essay, '')}>
      <span class="eyebrow">Read the essay</span>
      <span class="tv-essay__title">{essay.data.title}</span>
    </a>
  )}

  {v.tags && v.tags.length > 0 && (
    <ul class="tv-tags" aria-label="Tags">
      {v.tags.map((t) => <li>{t}</li>)}
    </ul>
  )}

  {more.length > 0 && (
    <section class="tv-more" aria-labelledby="tv-more-heading">
      <h2 id="tv-more-heading">More videos</h2>
      <div class="tv-grid">
        {more.map((m) => <VideoCard video={m} />)}
      </div>
    </section>
  )}

  <script type="application/ld+json" is:inline set:html={jsonLd} />

  <script>
    import '@mux/mux-player'
    import '../../scripts/video-stats.ts'
    import '../../scripts/share.ts'
  </script>
</BaseLayout>
