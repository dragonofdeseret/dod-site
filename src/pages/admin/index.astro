---
// ──────────────────────────────────────────────────────────────────────────────
// /admin — dashboard. Lists collections + per-collection entry counts +
// the five most recently dated entries across the site.
//
// Read live from GitHub (lib/live-content) so counts and the recent list
// reflect saves made since the last deploy.
// ──────────────────────────────────────────────────────────────────────────────

export const prerender = false

import AdminLayout from '../../layouts/AdminLayout.astro'
import { liveEntries, type LiveEntry } from '../../lib/live-content'

const { live, failed, byCollection } = await liveEntries(['art', 'photo', 'writing', 'margins', 'quotes'])
const { art, photo, writing, margins, quotes } = byCollection as Record<string, LiveEntry[]>

const totals = [
  { name: 'Artwork',     count: art.length,     href: '/admin/art' },
  { name: 'Photography', count: photo.length,   href: '/admin/photo' },
  { name: 'Writing',     count: writing.length, href: '/admin/writing' },
  { name: 'Margins',     count: margins.length, href: '/admin/margins' },
  { name: 'Quotes',      count: quotes.length,  href: '/admin/quotes' },
]

// Five most-recent across everything that has a date.
const allDated = [
  ...art.map((e) => ({ ...e, collection: 'art' })),
  ...photo.map((e) => ({ ...e, collection: 'photo' })),
  ...writing.map((e) => ({ ...e, collection: 'writing' })),
  ...margins.map((e) => ({ ...e, collection: 'margins' })),
]
  .map((it) => ({ ...it, ts: Date.parse(String(it.data.date ?? '')) || 0 }))
  .filter((it) => it.ts > 0)
  .sort((a, b) => b.ts - a.ts)
  .slice(0, 5)
---

<AdminLayout title="Dashboard" active="dashboard">
  <h1 class="admin-h1">Dashboard</h1>
  <p class="admin-subtitle">{`Signed in as ${Astro.locals.user?.email ?? 'admin'}`}</p>

  {!live && (
    <div class="admin-flash admin-flash--error">
      Couldn't reach GitHub, so these counts are from the last site build and
      may not include changes from the last few minutes.
    </div>
  )}

  {failed.length > 0 && (
    <div class="admin-flash admin-flash--error">
      {failed.length === 1 ? 'One file' : `${failed.length} files`} on GitHub couldn't be loaded,
      so {failed.length === 1 ? "it's" : "they're"} shown from the last site build:{' '}
      {failed.map((p) => p.replace('src/content/', '')).join(', ')}
    </div>
  )}

  <div class="admin-card">
    <h2 class="admin-card__title">Collections</h2>
    <ul class="admin-list">
      {totals.map((t) => (
        <li class="admin-list__row">
          <a href={t.href}>{t.name}</a>
          <span class="admin-list__meta">{t.count} entries</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="admin-card">
    <h2 class="admin-card__title">Recent</h2>
    {allDated.length === 0 ? (
      <p class="admin-list__meta">No dated entries yet.</p>
    ) : (
      <ul class="admin-list">
        {allDated.map((it) => (
          <li class="admin-list__row">
            <a href={`/admin/${it.collection}/${it.id}`}>
              {String(it.data.title ?? it.id)} <span class="admin-list__meta">· {it.collection}</span>
            </a>
            <span class="admin-list__meta">{String(it.data.date)}</span>
          </li>
        ))}
      </ul>
    )}
  </div>
</AdminLayout>
