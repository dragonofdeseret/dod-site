---
// ──────────────────────────────────────────────────────────────────────────────
// /admin/[collection] — browse view for one collection. Lists every entry
// newest-first with edit + delete affordances. Works for every
// collection via the dynamic param.
//
// Read live from GitHub (lib/live-content), not from the content baked into
// this deployment, so an entry saved, created or deleted a moment ago shows
// correctly without waiting for Vercel to rebuild.
// ──────────────────────────────────────────────────────────────────────────────

export const prerender = false

import AdminLayout from '../../../layouts/AdminLayout.astro'
import { liveEntries } from '../../../lib/live-content'

const { collection } = Astro.params

const KNOWN = ['art', 'photo', 'writing', 'margins', 'quotes', 'video', 'site'] as const
type Known = (typeof KNOWN)[number]

if (!collection || !KNOWN.includes(collection as Known)) {
  return Astro.redirect('/admin')
}
const col = collection as Known

const LABELS: Record<Known, string> = {
  art: 'Artwork',
  photo: 'Photography',
  writing: 'Writing',
  margins: 'Margins',
  quotes: 'Quotes',
  video: 'Video',
  site: 'Site pages',
}

type Row = {
  id: string
  path?: string
  data: { id?: string; title?: string; date?: string; year?: number; author?: string; source?: string; hidden?: boolean }
}
const { live, failed, byCollection } = await liveEntries([col])
const raw = byCollection[col] as unknown as Row[]
const items = [...raw].sort((a, b) => {
  const ad = Date.parse(a.data.date ?? '') || 0
  const bd = Date.parse(b.data.date ?? '') || 0
  return bd - ad
})

// Two files should never share an id, but it can happen (e.g. a year change
// whose clean-up failed half-way). Such rows would otherwise look identical
// and both open the same file, so each one names its year folder and links
// to its own file.
const idCount = new Map<string, number>()
for (const it of items) {
  const id = it.data.id ?? it.id
  idCount.set(id, (idCount.get(id) ?? 0) + 1)
}
const yearFolder = (path?: string) => path?.match(/\/(\d{4})\/[^/]+\.md$/)?.[1]
---

<AdminLayout title={LABELS[col]} active={col}>
  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px;">
    <div>
      <h1 class="admin-h1">{LABELS[col]}</h1>
      <p class="admin-subtitle">{items.length} {items.length === 1 ? 'entry' : 'entries'}</p>
    </div>
    <a class="admin-button" href={`/admin/${col}/new`}>+ New {col === 'quotes' ? 'quote' : col === 'margins' ? 'note' : col === 'writing' ? 'essay' : col}</a>
  </div>

  {!live && (
    <div class="admin-flash admin-flash--error">
      Couldn't reach GitHub, so this list is from the last site build and may
      be missing entries saved in the last few minutes.
    </div>
  )}

  {failed.length > 0 && (
    <div class="admin-flash admin-flash--error">
      {failed.length === 1 ? 'One file' : `${failed.length} files`} on GitHub couldn't be loaded,
      so {failed.length === 1 ? "it's" : "they're"} shown from the last site build:{' '}
      {failed.map((p) => p.replace('src/content/', '')).join(', ')}
    </div>
  )}

  <div class="admin-card">
    {items.length === 0 ? (
      <p class="admin-list__meta">No entries yet. Click "+ New" above to add the first one.</p>
    ) : (
      <ul class="admin-list">
        {items.map((it) => {
          const id = it.data.id ?? it.id
          const title =
            it.data.title ??
            (it.data.author && it.data.source
              ? `${it.data.author} — ${it.data.source}`
              : it.data.author || it.data.source || id)
          const folder = (idCount.get(id) ?? 0) > 1 ? yearFolder(it.path) : undefined
          return (
            <li class="admin-list__row">
              <a href={`/admin/${col}/${id}${folder ? `?y=${folder}` : ''}`}>
                {title}
                {folder && <span class="admin-hidden-badge">Duplicate · {folder} folder</span>}
                {it.data.hidden && <span class="admin-hidden-badge">Hidden</span>}
              </a>
              <span class="admin-list__meta">{it.data.date ?? '—'}</span>
            </li>
          )
        })}
      </ul>
    )}
  </div>
</AdminLayout>
