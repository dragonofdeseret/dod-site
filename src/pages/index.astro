---
// ──────────────────────────────────────────────────────────────────────────────
// / — homepage. Library design system, "real entry point" structure:
//   • Typographic identity (masthead)
//   • Voice statement (who/what/why — 2-4 sentences)
//   • Featured (latest essay surfaced prominently)
//   • Sections-as-invitations (each major area with a one-line description
//     of what's there)
//   • Latest activity (5 most recent items across types)
//   • Colophon footer (RSS, second domain note, etc.)
//
// Drops the sidebar entirely on this page — the visitor needs an
// invitation, not a navigation panel. Sidebar reappears on every
// inner route.
// ──────────────────────────────────────────────────────────────────────────────

// Static prerender — built at deploy time. Astro emits HTML; no
// serverless function. Admin routes opt OUT with prerender = false.
export const prerender = true

import { getCollection } from 'astro:content'
import HomeLayout from '../layouts/HomeLayout.astro'
import { publicOnly } from '../lib/sort-group'

// Pull every collection so we can surface a curated featured + latest.
const [art, photo, writing, margins, quotes] = await Promise.all([
  getCollection('art').then(publicOnly),
  getCollection('photo').then(publicOnly),
  getCollection('writing').then(publicOnly),
  getCollection('margins'),
  getCollection('quotes'),
])

// Featured = most recent non-trip-report essay. If none, fall back to
// most recent margin. The point is to lead the visitor into the
// thinking, not the gallery.
const writingSorted = [...writing]
  .filter((w) => !(Array.isArray(w.data.sections) && w.data.sections.includes('trips')))
  .sort((a, b) => Date.parse(b.data.date) - Date.parse(a.data.date))
const featured = writingSorted[0] ?? null

// Latest = 5 most recent items across writing/art/photo/margins.
type Dated = { collection: string; data: { id?: string; title?: string; date?: string } }
const latestAll: Dated[] = [
  ...writing.map((w) => ({ collection: 'writing', data: w.data })),
  ...art.map((a) => ({ collection: 'art', data: a.data })),
  ...photo.map((p) => ({ collection: 'photo', data: p.data })),
  ...margins.map((m) => ({ collection: 'margins', data: m.data })),
]
const latest = latestAll
  .filter((it) => it.data.date)
  .sort((a, b) => Date.parse(b.data.date!) - Date.parse(a.data.date!))
  .slice(0, 5)

// Section descriptors — these read like a magazine's table of contents,
// not just nav. Each one tells the visitor what kind of material lives
// there.
const sections = [
  {
    href: '/writing',
    eyebrow: 'Essays',
    title: 'Writing',
    body: 'Long-form pieces on harmonic theism, Mormon metaphysics, phenomenology of exotic states of consciousness, and the texture of belief.',
    count: writing.length,
  },
  {
    href: '/art',
    eyebrow: 'Studio',
    title: 'Artwork',
    body: 'Artpocrypha.',
    count: art.length,
  },
  {
    href: '/photography',
    eyebrow: 'Lens',
    title: 'Photography',
    body: 'Field notes from the eye.',
    count: photo.length,
  },
  {
    href: '/margins',
    eyebrow: 'Notes',
    title: 'Margins & Excerpts',
    body: 'Marginalia from the books, the dreams, the long conversations. Short forms.',
    count: margins.length,
  },
  {
    href: '/exotic-states-of-consciousness',
    eyebrow: 'Reports',
    title: 'Exotic States of Consciousness',
    body: 'Field notes and phenomenology from Exotic States of Consciousness: Vision, Sleep Paralysis, Meditation, Cannabis, LSD, DMT, Psilocybin.',
    count: writing.filter((w) => Array.isArray(w.data.sections) && w.data.sections.includes('trips')).length,
  },
  {
    href: '/now',
    eyebrow: 'Current',
    title: 'Now',
    body: 'What I am painting, writing, and reading at this moment.',
    count: null,
  },
]

// A featured quote rotates daily based on the date — picks one of the
// quotes collection entries deterministically. No JS required.
const today = new Date()
const dayIndex =
  today.getUTCFullYear() * 1000 + today.getUTCMonth() * 50 + today.getUTCDate()
const quoteOfDay = quotes.length > 0 ? quotes[dayIndex % quotes.length] : null
---

<HomeLayout title="Home">
  <div class="home">
    {/* ── Masthead ───────────────────────────────────────────────── */}
    <header class="home__masthead">
      <h1 class="home__name">Christopher Shenefelt</h1>
      <p class="home__monicker">The Dragon of Deseret</p>
      <div class="home__rule" />
    </header>

    {/* ── Voice / opening invocation ──────────────────────────────── */}
    <section class="home__voice">
      <p class="home__voice-lead">A Living Archive.</p>
      <p class="home__voice-text">
        Art. Photography. Thoughts on Mormonism, Daoism, Zen,
        Consciousness, and Phenomenology.
      </p>
    </section>

    {/* ── Featured book: Harmonic Theism ─────────────────────────────
       Sits above the latest essay because it's the centerpiece work.
       Two-column on desktop (cover left, copy right), stacked on
       mobile. Direct link to Amazon. */}
    <section class="home__book">
      <a class="home__book-link" href="/harmonic-theism">
        <div class="home__book-cover">
          <img
            src="/images/book/ht-cover.png"
            alt="Harmonic Theism: Symphony No. I — book cover"
            width="220"
            height="330"
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="home__book-body">
          <div class="home__book-eyebrow eyebrow">New Release · Symphony No. I</div>
          <h2 class="home__book-title">Harmonic Theism</h2>
          <p class="home__book-subtitle">
            <em>Creatio ex Concordia and the Divine Arrangement of Worlds</em>
          </p>
          <p class="home__book-blurb">
            A symphonic theology in eight movements. The first volume reframes
            the central attributes of God not as static absolutes but as living
            harmonics — omniscience as <em>shared knowing</em>, omnipresence as
            <em>manifest resonance</em>, omnipotence as <em>collaboration</em>,
            eternity as <em>cadence</em>. Weaving LDS theology with Daoism,
            Zen, contemporary science and literature, and more, it proposes
            <em>creatio ex concordia</em> — creation from harmony — as the
            most coherent way to read both the cosmos and the soul.
          </p>
          <span class="home__book-cta">Read more →</span>
        </div>
      </a>
    </section>

    {/* ── Featured essay ───────────────────────────────────────────── */}
    {featured && (
      <section class="home__featured">
        <div class="home__featured-eyebrow eyebrow">Featured · Latest essay</div>
        <h2 class="home__featured-title">
          <a href={`/writing/${featured.data.id}`}>
            {featured.data.title.includes(' | ') ? (
              <>
                <span class="home__featured-title-main">
                  {featured.data.title.split(' | ')[0]}
                </span>
                <span class="home__featured-title-sub">
                  | {featured.data.title.split(' | ').slice(1).join(' | ')}
                </span>
              </>
            ) : (
              featured.data.title
            )}
          </a>
        </h2>
        {featured.data.tags && featured.data.tags.length > 0 && (
          <div class="home__featured-tags">
            {featured.data.tags.slice(0, 5).map((t) => (
              <span class="home__tag">{t}</span>
            ))}
          </div>
        )}
        <a class="home__featured-read" href={`/writing/${featured.data.id}`}>
          Read the essay →
        </a>
      </section>
    )}

    {/* ── Sections (the table of contents, as invitation) ─────────── */}
    <section class="home__sections">
      <div class="home__section-header eyebrow">Sections</div>
      <ul class="home__section-list">
        {sections.map((s) => (
          <li class="home__section-row">
            <a href={s.href} class="home__section-link">
              <div class="home__section-eyebrow">{s.eyebrow}</div>
              <h3 class="home__section-title">{s.title}</h3>
              <p class="home__section-body">{s.body}</p>
              {s.count !== null && (
                <span class="home__section-count">
                  {s.count} {s.count === 1 ? 'entry' : 'entries'}
                </span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </section>

    {/* ── Latest activity ────────────────────────────────────────── */}
    <section class="home__latest">
      <div class="home__section-header eyebrow">Recently added</div>
      <ul class="home__latest-list">
        {latest.map((it) => {
          const url =
            it.collection === 'writing'
              ? `/writing/${it.data.id}`
              : it.collection === 'art'
                ? `/art/${it.data.id}`
                : it.collection === 'photo'
                  ? `/photography/${it.data.id}`
                  : `/margins#${it.data.id}`
          return (
            <li class="home__latest-row">
              <span class="home__latest-kind">{it.collection}</span>
              <a class="home__latest-title" href={url}>
                {it.data.title}
              </a>
              <span class="home__latest-date mono">{it.data.date}</span>
            </li>
          )
        })}
      </ul>
    </section>

    {/* ── Quote of the day ───────────────────────────────────────── */}
    {quoteOfDay && (
      <>
        <hr class="asterism" />
        <section class="home__quote">
          <blockquote class="home__quote-text">
            {(quoteOfDay.body ?? '').trim()}
            <cite>
              {quoteOfDay.data.author}
              {quoteOfDay.data.source && (
                <span class="home__quote-source"> · {quoteOfDay.data.source}</span>
              )}
            </cite>
          </blockquote>
        </section>
      </>
    )}

    {/* ── Colophon footer ────────────────────────────────────────── */}
    <footer class="home__colophon">
      <div class="home__colophon-rule" />
      <div class="home__colophon-grid">
        <div>
          <div class="eyebrow">About</div>
          <p>
            <a href="/bio">Biography</a> · <a href="/questions">Questions</a>
          </p>
        </div>
        <div>
          <div class="eyebrow">Works</div>
          <p>
            <a
              href="https://a.co/d/04zcw8xP"
              target="_blank"
              rel="noopener"
            >
              Harmonic Theism ↗
            </a>{' '}
            ·{' '}
            <a
              href="https://valencejournal.com"
              target="_blank"
              rel="noopener"
            >
              Valence Journal ↗
            </a>
          </p>
        </div>
        <div>
          <div class="eyebrow">Elsewhere</div>
          <p>
            <a
              href="https://www.instagram.com/dragonofdeseret/"
              target="_blank"
              rel="noopener"
            >
              Instagram ↗
            </a>{' '}
            ·{' '}
            <a
              href="https://x.com/dragonofdeseret"
              target="_blank"
              rel="noopener"
            >
              X ↗
            </a>
          </p>
        </div>
      </div>
      <p class="home__colophon-mark mono">
        © {new Date().getFullYear()} Christopher Shenefelt · the Dragon of Deseret
        · artwork and writing © their respective years
      </p>
    </footer>
  </div>
</HomeLayout>

<style>
  /* ──────────────────────────────────────────────────────────────────────
     Homepage. Valence register (see global.css): cards on the ground,
     hairlines, one accent, the system face. Centred single column.
     ────────────────────────────────────────────────────────────────────── */

  .home {
    max-width: 760px;
    margin: 0 auto;
    padding: 56px 0 96px;
  }

  /* Shared card surface for every block on the page. */
  .home__book-link,
  .home__featured,
  .home__section-link,
  .home__latest-row,
  .home__quote {
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--panel-shadow);
  }

  /* ── Masthead ──────────────────────────────────────────────────────── */
  .home__masthead {
    text-align: center;
    margin-bottom: 28px;
  }
  .home__name {
    font-size: var(--fs-display);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin: 0;
  }
  .home__monicker {
    margin: 14px 0 0 0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    line-height: 1;
  }
  .home__rule {
    width: 48px;
    height: 1px;
    background: var(--border);
    margin: 28px auto 0;
  }

  /* ── Voice ─────────────────────────────────────────────────────────── */
  .home__voice {
    margin: 0 0 48px 0;
    text-align: center;
  }
  .home__voice-lead {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--text);
    margin: 0 0 0.35em 0;
    line-height: 1.2;
  }
  .home__voice-text {
    font-size: 17px;
    line-height: 1.55;
    color: var(--text-muted);
    margin: 0;
  }

  /* ── Featured book (Harmonic Theism) ─────────────────────────────────── */
  .home__book { margin: 0 0 20px 0; }
  .home__book-link {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 28px;
    align-items: start;
    padding: 28px;
    text-decoration: none;
    color: inherit;
    transition: border-color 150ms ease;
  }
  .home__book-link:hover {
    border-color: var(--accent-border);
    text-decoration: none;
  }
  .home__book-cover {
    aspect-ratio: 2 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 6px 18px -8px rgba(0, 0, 0, 0.45);
  }
  .home__book-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .home__book-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .home__book-eyebrow { color: var(--accent); }
  .home__book-title {
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.1;
    margin: 2px 0 0 0;
  }
  .home__book-subtitle {
    color: var(--text-muted);
    font-size: 16px;
    margin: 4px 0 14px 0;
    line-height: 1.4;
  }
  .home__book-subtitle em { font-style: normal; }
  .home__book-blurb {
    margin: 0 0 18px 0;
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-muted);
  }
  .home__book-blurb em {
    color: var(--text);
    font-style: italic;
  }
  /* The whole card is the link; this reads as its primary button. */
  .home__book-cta {
    display: inline-block;
    align-self: start;
    padding: 9px 18px;
    background: var(--accent);
    color: var(--on-accent);
    border: 1.5px solid var(--btn-edge);
    box-shadow: 0 2px 0 0 var(--btn-edge);
    border-radius: var(--radius-md);
    font-size: 14px;
    font-weight: 600;
    transition: background-color 120ms ease;
  }
  .home__book-link:hover .home__book-cta { background: var(--accent-deep); }

  /* ── Featured essay ────────────────────────────────────────────────── */
  .home__featured {
    margin: 0 0 48px 0;
    padding: 28px 32px;
    text-align: center;
  }
  .home__featured-eyebrow { margin: 0 0 10px 0; }
  .home__featured-title {
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 12px 0;
    line-height: 1.15;
  }
  .home__featured-title a {
    color: var(--text);
    text-decoration: none;
    display: inline-block;
  }
  .home__featured-title a:hover { color: var(--accent); }
  .home__featured-title-main { display: block; }
  .home__featured-title-sub {
    display: block;
    margin-top: 6px;
    font-size: 0.62em;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-muted);
  }
  .home__featured-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px;
    margin-bottom: 18px;
  }
  .home__tag {
    padding: 1px 9px;
    background: var(--surface);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 500;
    color: var(--text-muted);
  }
  .home__featured-read {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--accent);
  }

  /* ── Section header (Sections / Recently added) ────────────────────── */
  .home__section-header {
    display: block;
    margin-bottom: 14px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border-soft);
  }

  /* ── Sections ──────────────────────────────────────────────────────── */
  .home__sections { margin: 0 0 48px 0; }
  .home__section-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .home__section-link {
    display: block;
    height: 100%;
    padding: 18px 20px;
    text-decoration: none;
    color: var(--text);
    transition: border-color 150ms ease;
  }
  .home__section-link:hover {
    border-color: var(--accent-border);
    text-decoration: none;
  }
  .home__section-eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 4px;
  }
  .home__section-title {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 6px 0;
    line-height: 1.25;
  }
  .home__section-link:hover .home__section-title { color: var(--accent); }
  .home__section-body {
    margin: 0 0 10px 0;
    color: var(--text-muted);
    font-size: 14px;
    line-height: 1.55;
  }
  .home__section-count {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  /* ── Latest ────────────────────────────────────────────────────────── */
  .home__latest { margin: 0 0 48px 0; }
  .home__latest-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .home__latest-row {
    display: grid;
    grid-template-columns: 80px 1fr auto;
    align-items: baseline;
    gap: 14px;
    padding: 12px 18px;
    transition: border-color 150ms ease;
  }
  .home__latest-row:hover { border-color: var(--accent-border); }
  .home__latest-kind {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .home__latest-title {
    color: var(--text);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.35;
  }
  .home__latest-title:hover { color: var(--accent); }
  .home__latest-date {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--text-faint);
  }

  /* ── Quote ─────────────────────────────────────────────────────────── */
  .home__quote {
    margin: 0 0 48px 0;
    padding: 30px 36px;
  }
  .home__quote-text {
    font-size: 19px;
    line-height: 1.55;
    color: var(--text);
    border-left: none;
    padding: 0;
    margin: 0;
    text-align: center;
  }
  .home__quote-text cite { margin-top: 14px; }

  /* ── Colophon ──────────────────────────────────────────────────────── */
  .home__colophon { margin-top: 64px; }
  .home__colophon-rule {
    height: 1px;
    background: var(--border-soft);
    margin-bottom: 24px;
  }
  .home__colophon-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 24px;
    font-size: 13px;
  }
  .home__colophon-grid .eyebrow { margin-bottom: 4px; }
  .home__colophon-grid p {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.7;
  }
  .home__colophon-grid a { color: var(--text-muted); }
  .home__colophon-grid a:hover { color: var(--accent); }
  .home__colophon-mark {
    text-align: center;
    color: var(--text-faint);
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 1.5;
  }

  /* ── Responsive ────────────────────────────────────────────────────── */
  @media (max-width: 700px) {
    .home { padding: 32px 0 64px; }
    .home__name { font-size: 36px; }
    .home__book-link {
      grid-template-columns: 1fr;
      padding: 22px;
      gap: 20px;
    }
    .home__book-cover {
      max-width: 180px;
      margin: 0 auto;
    }
    .home__book-title { font-size: 26px; text-align: center; }
    .home__book-subtitle,
    .home__book-eyebrow { text-align: center; }
    .home__book-cta { align-self: center; }
    .home__featured { padding: 22px 20px; }
    .home__featured-title { font-size: 22px; }
    .home__section-list { grid-template-columns: 1fr; }
    .home__latest-row {
      grid-template-columns: 70px 1fr;
      grid-template-rows: auto auto;
      padding: 12px 14px;
    }
    .home__latest-date {
      grid-column: 2;
      grid-row: 2;
      margin-top: 2px;
    }
    .home__colophon-grid { grid-template-columns: 1fr 1fr; }
    .home__quote { padding: 22px 20px; }
    .home__quote-text { font-size: 17px; }
  }
</style>
