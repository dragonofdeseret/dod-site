---
// ──────────────────────────────────────────────────────────────────────────────
// /checkout/success — landing page after a Stripe Checkout Session completes.
//
// We don't verify anything client-side; the webhook is the canonical "order
// is done" event. This page exists purely as a confirmation to the buyer
// and a clear path back into the site. Library-aesthetic so it reads as
// part of the gallery, not a generic SaaS thank-you screen.
// ──────────────────────────────────────────────────────────────────────────────

export const prerender = false

import BaseLayout from '../../layouts/BaseLayout.astro'

const sid = Astro.url.searchParams.get('sid')
---

<BaseLayout title="Thank you" active="home">
  <div class="thanks">
    <div class="thanks__kicker">Confirmed</div>
    <h1 class="thanks__title">Thank you.</h1>
    <p class="thanks__lead">Your print is on its way.</p>

    <div class="thanks__rule"></div>

    <p class="thanks__body">
      A receipt from Stripe is on its way to your email. Your print will be
      packed and shipped within a few business days; once it's on the way
      you'll get a tracking number directly from the courier.
    </p>
    <p class="thanks__body">
      Thank you for supporting the work.
    </p>

    <div class="thanks__signoff">
      <span>— Christopher</span>
      <span class="thanks__monicker">The Dragon of Deseret</span>
    </div>

    <div class="thanks__actions">
      <a class="thanks__btn" href="/prints">Browse more prints</a>
      <a class="thanks__btn thanks__btn--ghost" href="/">Return home</a>
    </div>

    {sid && (
      <p class="thanks__ref">
        Order reference · <code>{sid}</code>
      </p>
    )}
  </div>
</BaseLayout>

<style>
  .thanks {
    max-width: 620px;
    margin: 48px auto;
    padding: 44px 44px 36px;
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--panel-shadow);
    text-align: center;
  }
  .thanks__kicker {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 8px;
  }
  .thanks__title {
    font-size: 40px;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0 0 8px 0;
  }
  .thanks__lead {
    color: var(--text-muted);
    font-size: 17px;
    margin: 0 0 24px 0;
  }
  .thanks__rule {
    width: 48px;
    height: 1px;
    background: var(--border);
    margin: 0 auto 24px;
  }
  .thanks__body {
    color: var(--text-muted);
    font-size: 15px;
    line-height: 1.65;
    margin: 0 auto 14px;
    text-align: left;
    max-width: 480px;
  }
  .thanks__signoff {
    margin: 28px 0 32px 0;
    color: var(--text);
    font-size: 15px;
    font-weight: 600;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .thanks__monicker {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .thanks__actions {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .thanks__btn {
    display: inline-block;
    padding: 9px 20px;
    background: var(--accent);
    color: var(--on-accent);
    border: 1.5px solid var(--btn-edge);
    box-shadow: 0 2px 0 0 var(--btn-edge);
    border-radius: var(--radius-md);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 120ms ease;
  }
  .thanks__btn:hover {
    background: var(--accent-deep);
    color: var(--on-accent);
    text-decoration: none;
  }
  .thanks__btn--ghost {
    background: var(--panel);
    color: var(--text);
    border: 1px solid var(--border);
    box-shadow: none;
  }
  .thanks__btn--ghost:hover {
    background: var(--panel);
    color: var(--accent);
    border-color: var(--accent-border);
  }
  .thanks__ref {
    margin: 20px 0 0 0;
    font-size: 11px;
    color: var(--text-faint);
    font-family: var(--font-mono);
  }
  .thanks__ref code {
    font-family: inherit;
    background: transparent;
    padding: 0;
  }
  @media (max-width: 600px) {
    .thanks { padding: 30px 22px 26px; margin: 24px 0; }
    .thanks__title { font-size: 32px; }
  }
</style>
