---
// Static prerender — built at deploy time. Astro emits HTML; no
// serverless function. Admin routes opt OUT with prerender = false.
export const prerender = true

// ──────────────────────────────────────────────────────────────────────────────
// /writing — essays + excerpts, grouped by year. Markup mirrors legacy
// buildWritingIndex(): each row is itself an <a> (whole-row clickable),
// title + inline tag pills on top, date on the right.
//
// Trip reports are filtered OUT here (they live on /exotic-states-of-consciousness), per
// legacy behavior.
// ──────────────────────────────────────────────────────────────────────────────

import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import AdminAdd from '../components/AdminAdd.astro'
import { groupByYear, publicOnly } from '../lib/sort-group'

const writing = publicOnly(await getCollection('writing'))

// Trip reports (sections: ['trips']) belong on /exotic-states-of-consciousness, not here.
const indexItems = writing.filter(
  (it) => !(Array.isArray(it.data.sections) && it.data.sections.includes('trips')),
)
const grouped = groupByYear(indexItems)
---

<BaseLayout title="Writing" active="writing">
  <AdminAdd collection="writing" label="Add essay" />

  {/* ── Harmonic Theism banner ─────────────────────────────────────
     Pinned at the top of /writing so the book is the first thing a
     reader encounters before diving into the essays grid. Cover on
     the left, blurb + Amazon CTA on the right. */}
  <aside class="writing__book">
    <a class="writing__book-link" href="/harmonic-theism">
      <div class="writing__book-cover">
        <img
          src="/images/book/ht-cover.png"
          alt="Harmonic Theism: Symphony No. I — book cover"
          width="180"
          height="270"
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="writing__book-body">
        <div class="writing__book-eyebrow">Now in print · Symphony No. I</div>
        <h2 class="writing__book-title">Harmonic Theism</h2>
        <p class="writing__book-subtitle">
          <em>Creatio ex Concordia and the Divine Arrangement of Worlds</em>
        </p>
        <p class="writing__book-blurb">
          Eight movements that recast classical theology in the language of
          music — where omniscience becomes shared knowing, omnipresence
          becomes manifest resonance, omnipotence becomes collaboration, and
          eternity becomes cadence. A symphony for those who would hear God
          not as a static absolute but as a living harmonic.
        </p>
        <span class="writing__book-cta">Read more →</span>
      </div>
    </a>
  </aside>

  <header class="page-header">
    <h1>Writings</h1>
    <p class="page-intro">Essays, Excerpts, and Musings.</p>
    <nav class="year-nav">
      {grouped.map((g) => <a href={`#year-${g.year}`}>{g.year}</a>)}
    </nav>
    <div class="filter-block">
      <div class="filter-row">
        <div
          class="tag-filter tag-filter-writing"
          data-filter-name="writingTags"
          data-filter-target=".archive-list > .archive-row"
          data-filter-key="writing-tags"
          data-filter-mode="or"
        />
      </div>
    </div>
  </header>

  <div id="writing">
    {grouped.map((g) => (
      <div class="archive-year" id={`year-${g.year}`}>
        <h2>{g.year}</h2>
        <div class="archive-list">
          {g.items.map((it) => (
            <a
              class="archive-row"
              href={`/writing/${it.data.id}`}
              data-writing-tags={(it.data.tags ?? []).join(',')}
            >
              <div class="archive-title">
                {it.data.title}
                {it.data.tags && it.data.tags.length > 0 && (
                  <div class="item-tags-inline">
                    {it.data.tags.map((t) => (
                      <span class="item-tag-inline">{t}</span>
                    ))}
                  </div>
                )}
              </div>
              <div class="archive-meta">{it.data.date || g.year}</div>
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>

  <script>
    import '../scripts/filter-engine.ts'
  </script>
</BaseLayout>

<style>
  /* Writing-page Harmonic Theism banner — same card as the homepage book
     block, a little more horizontal because /writing is wider. */
  .writing__book { margin: 0 0 28px 0; }
  .writing__book-link {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 24px;
    align-items: start;
    padding: 22px 24px;
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--panel-shadow);
    text-decoration: none;
    color: inherit;
    transition: border-color 150ms ease;
  }
  .writing__book-link:hover {
    border-color: var(--accent-border);
    text-decoration: none;
  }
  .writing__book-cover {
    aspect-ratio: 2 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 6px 18px -8px rgba(0, 0, 0, 0.45);
  }
  .writing__book-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .writing__book-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .writing__book-eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 2px;
  }
  .writing__book-title {
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0;
  }
  .writing__book-subtitle {
    color: var(--text-muted);
    font-size: 14px;
    margin: 4px 0 12px 0;
  }
  .writing__book-blurb {
    margin: 0 0 16px 0;
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-muted);
  }
  .writing__book-cta {
    display: inline-block;
    align-self: start;
    padding: 8px 16px;
    background: var(--accent);
    color: var(--on-accent);
    border: 1.5px solid var(--btn-edge);
    box-shadow: 0 2px 0 0 var(--btn-edge);
    border-radius: var(--radius-md);
    font-size: 13px;
    font-weight: 600;
    transition: background-color 120ms ease;
  }
  .writing__book-link:hover .writing__book-cta { background: var(--accent-deep); }
  @media (max-width: 620px) {
    .writing__book-link {
      grid-template-columns: 1fr;
      padding: 20px;
      gap: 16px;
    }
    .writing__book-cover {
      max-width: 160px;
      margin: 0 auto;
    }
    .writing__book-title,
    .writing__book-subtitle,
    .writing__book-eyebrow { text-align: center; }
    .writing__book-cta { align-self: center; }
  }
</style>
