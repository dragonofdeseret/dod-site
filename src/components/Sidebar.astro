---
// ──────────────────────────────────────────────────────────────────────────────
// Sidebar — single nav definition. Pass `active` to highlight the current
// top-level link and `subActive` for a sub-nav link (e.g. "exotic-states"
// under Writing).
//
//   <Sidebar active="archive" />
//
// Styling lives in src/styles/global.css (.sidebar, .sidebar-nav,
// .sidebar-foot) with the rest of the design system.
// ──────────────────────────────────────────────────────────────────────────────

import ThemeToggle from './ThemeToggle.astro'

interface Props {
  active?:
    | 'home'
    | 'archive'
    | 'art'
    | 'writing'
    | 'now'
    | 'prints'
    | 'questions'
    | 'bio'
  subActive?:
    // Art sub-nav
    | 'exhibits'
    | 'photo'
    // Writing sub-nav
    | 'exotic-states'
    | 'margins'
    | 'quotes'
    | 'harmonic-theism'
}

const { active, subActive } = Astro.props

const cls = (key: NonNullable<Props['active']>) =>
  active === key ? 'active' : undefined
const subCls = (key: NonNullable<Props['subActive']>) =>
  subActive === key ? 'nav-sub active' : 'nav-sub'

const PROJECTS = [
  'valencejournal.com',
  'faultlineutah.com',
  'prepareutah.com',
  'hivewatchutah.com',
]
---

<nav class="sidebar" aria-label="Site">
  <h1>Christopher Shenefelt</h1>

  <div class="sidebar-nav">
    <a href="/" class={cls('home')}>Home</a>
    {/* Archive intentionally hidden from the sidebar for now — the page
        itself still exists at /archive, just not linked. Restore by
        uncommenting this line:
        <a href="/archive" class={cls('archive')}>Archive</a> */}

    <a href="/art" class={cls('art')}>Artwork</a>
    {active === 'art' && (
      <>
        <a href="/exhibits" class={subCls('exhibits')}>Exhibits</a>
        <a href="/photography" class={subCls('photo')}>Photography</a>
      </>
    )}

    <a href="/writing" class={cls('writing')}>Writing</a>
    {active === 'writing' && (
      <>
        <a href="/harmonic-theism" class={subCls('harmonic-theism')}>Harmonic Theism</a>
        <a href="/exotic-states-of-consciousness" class={subCls('exotic-states')}>Exotic States of Consciousness</a>
        <a href="/margins" class={subCls('margins')}>Margins &amp; Excerpts</a>
        <a href="/quotes" class={subCls('quotes')}>Quotes from Others</a>
      </>
    )}

    <a href="/now" class={cls('now')}>Now</a>
    <a href="/prints" class={cls('prints')}>Prints</a>
    <a href="/questions" class={cls('questions')}>Questions</a>
    <a href="/bio" class={cls('bio')}>Biography</a>
  </div>

  <div class="sidebar-foot">
    <ThemeToggle />

    {/* Sister projects, kept apart from the site sections above. */}
    <div class="sidebar-projects">
      <span class="sidebar-projects__label">Other projects</span>
      {PROJECTS.map((domain) => (
        <a href={`https://${domain}`} target="_blank" rel="noopener">{domain}</a>
      ))}
    </div>
  </div>

  {/* Social links (Harmonic Theism, Dao De Zion, Instagram, X) live in the
      homepage footer.

      No visible Admin link — keeps the public surface clean. The admin is
      reachable by typing /admin/login directly; the middleware gates
      everything underneath. */}
</nav>
