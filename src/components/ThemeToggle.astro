---
// ──────────────────────────────────────────────────────────────────────────────
// ThemeToggle — System / Light / Dark switch, as on Valence. "System" (the
// default) follows the OS setting live; Light and Dark are saved in
// localStorage `dod:theme`. ThemeScript.astro applies the choice before
// first paint; this component keeps it in sync after load.
//
// A proper ARIA radio group: one Tab stop (roving tabindex), arrow keys move
// and select, Space/Enter select. If storage is blocked the choice still
// applies for the current page (in-memory). Re-syncs when the page is
// restored from the back/forward cache and when another tab changes it.
// ──────────────────────────────────────────────────────────────────────────────
---

<div class="theme-switch" role="radiogroup" aria-label="Colour theme">
  <button type="button" role="radio" data-theme-choice="system" aria-label="System theme" title="System" aria-checked="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect width="20" height="14" x="2" y="3" rx="2" />
      <line x1="8" x2="16" y1="21" y2="21" />
      <line x1="12" x2="12" y1="17" y2="21" />
    </svg>
  </button>
  <button type="button" role="radio" data-theme-choice="light" aria-label="Light theme" title="Light" aria-checked="false" tabindex="-1">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
    </svg>
  </button>
  <button type="button" role="radio" data-theme-choice="dark" aria-label="Dark theme" title="Dark" aria-checked="false" tabindex="-1">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
    </svg>
  </button>
</div>

<script>
  type Choice = 'system' | 'light' | 'dark'
  const KEY = 'dod:theme'
  const media = window.matchMedia('(prefers-color-scheme: dark)')
  // In-memory choice, used only once storage has failed (blocked, or
  // read-only like old Safari private mode), so a click still takes effect.
  let memChoice: 'light' | 'dark' | null = null
  let storageFailed = false

  function saved(): 'light' | 'dark' | null {
    if (storageFailed) return memChoice
    try {
      const v = localStorage.getItem(KEY)
      return v === 'light' || v === 'dark' ? v : null
    } catch {
      storageFailed = true
      return memChoice
    }
  }

  function buttons(): HTMLButtonElement[] {
    return Array.from(document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]'))
  }

  function apply(): void {
    const choice = saved()
    const dark = choice ? choice === 'dark' : media.matches
    document.documentElement.classList.toggle('dark', dark)
    const current: Choice = choice ?? 'system'
    for (const btn of buttons()) {
      const on = btn.dataset.themeChoice === current
      btn.setAttribute('aria-checked', String(on))
      btn.tabIndex = on ? 0 : -1
    }
  }

  function choose(choice: Choice): void {
    memChoice = choice === 'system' ? null : choice
    try {
      if (choice === 'system') localStorage.removeItem(KEY)
      else localStorage.setItem(KEY, choice)
    } catch {
      storageFailed = true // memChoice carries the choice for this page
    }
    apply()
  }

  for (const btn of buttons()) {
    btn.addEventListener('click', () => choose(btn.dataset.themeChoice as Choice))
    btn.addEventListener('keydown', (e) => {
      const group = Array.from(btn.parentElement?.querySelectorAll<HTMLButtonElement>('[data-theme-choice]') ?? [])
      const i = group.indexOf(btn)
      let next = -1
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (i + 1) % group.length
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = (i - 1 + group.length) % group.length
      else if (e.key === 'Home') next = 0
      else if (e.key === 'End') next = group.length - 1
      if (next < 0) return
      e.preventDefault()
      const target = group[next]
      choose(target.dataset.themeChoice as Choice)
      target.focus()
    })
  }

  // While on "System", follow the OS live.
  media.addEventListener('change', () => {
    if (!saved()) apply()
  })
  // Restored from the back/forward cache: the saved choice may have changed.
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) apply()
  })
  // Changed in another tab.
  window.addEventListener('storage', (e) => {
    if (e.key === KEY || e.key === null) apply()
  })

  apply()
</script>
