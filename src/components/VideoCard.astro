---
// ──────────────────────────────────────────────────────────────────────────────
// VideoCard — one video as a link card: still image with a duration badge,
// then series label, title and date. Every card looks the same, on /tv and
// under "More videos" on a watch page.
//   level — heading level for the title (2 on /tv, 3 under "More videos")
//   eager — load the image straight away (cards visible on arrival)
//
// The image is the video's custom thumbnail if one was uploaded, otherwise
// a frame served by Mux's image CDN (lib/video.ts → videoStill).
// Styles: the "TV" section of src/styles/global.css.
// ──────────────────────────────────────────────────────────────────────────────

import type { CollectionEntry } from 'astro:content'
import { formatLongDate } from '../lib/format-date'
import { formatDuration, videoStill } from '../lib/video'

interface Props {
  video: CollectionEntry<'video'>
  level?: 2 | 3
  eager?: boolean
}

const { video, level = 3, eager = false } = Astro.props
const v = video.data
const w = 480
const Heading = level === 2 ? 'h2' : 'h3'
const thumb = (width: number) => videoStill(v, 'card', width)
const duration = formatDuration(v.durationSec)
---

<a class="tv-card" href={`/tv/${v.id}`}>
  <div class="tv-card__thumb">
    <img
      src={thumb(w)}
      srcset={thumb(w) === thumb(w * 2) ? undefined : `${thumb(w)} 1x, ${thumb(w * 2)} 2x`}
      width={w}
      height={Math.round((w * 9) / 16)}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      alt=""
    />
    {duration && <span class="tv-card__duration">{duration}</span>}
  </div>
  <div class="tv-card__body">
    {v.series && <span class="eyebrow">{v.series}</span>}
    <Heading class="tv-card__title">{v.title}</Heading>
    <span class="tv-card__date">{formatLongDate(v.date)}</span>
  </div>
</a>
